# Never commit a real .env file. Use a managed PostgreSQL connection in production.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=
# Set true only after confirming you actually offer pay on delivery.
ALLOW_PAY_ON_DELIVERY=true
# Bootstrap a unique admin account on a fresh database (use a strong password).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Server-side only. Never put this key in VITE_ variables.
PAYSTACK_SECRET_KEY=
# A verified, configured SMTP sender enables password-reset email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Image uploads from the admin panel (all three required).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# If behind a trusted reverse proxy, set to 1 after configuring that proxy correctly.
TRUST_PROXY=
